{
  "appearance": {
    "monitor": "\\\\.\\DISPLAY2",
    "flexDirection": "row",
    "alignment": "bottom-center",
    "marginX": 100,
    "marginY": 100,
    "animation": "fade",
    "groupAnimation": "slide",
    "useBlur": true,
    "animationDuration": 0.25,
    "style": "mechanical"
  },
  "layout": {
    "showIcon": true,
    "showSymbol": true,
    "showPressCount": false,
    "iconAlignment": "flex-end"
  },
  "color": {
    "color": "#343148",
    "secondaryColor": "#252333",
    "caption": "#000000",
    "useGradient": true,
    "useRGBLight": false
  },
  "modifier": {
    "highlight": false,
    "color": "#3a86ff",
    "secondaryColor": "#003c9c",
    "textColor": "#000000",
    "borderColor": "#000000"
  },
  "text": {
    "font": "Inter Variable",
    "size": 38,
    "color": "#D7C49E",
    "caps": "capitalize",
    "variant": "text-short",
    "alignment": "center"
  },
  "border": {
    "enabled": true,
    "width": 2,
    "color": "#252333",
    "radius": 0.5
  },
  "background": {
    "enabled": true,
    "color": "#ffffff99"
  },
  "mouse": {
    "showClicks": true,
    "clickAnimation": "ripple",
    "size": 150,
    "color": "#3A86FF",
    "keepHighlight": false,
    "showIndicator": false,
    "keepIndicator": true,
    "indicatorArtboard": "Mouse3",
    "indicatorSize": 50,
    "indicatorOffsetX": 50,
    "indicatorOffsetY": 50
  }
}